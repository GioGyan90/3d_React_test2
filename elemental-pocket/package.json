{
  "name": "elemental-pocket-effects",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable Three.js billiards pocket effects and interactive demo",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc --project tsconfig.lib.json",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.160.0",
    "three": "0.160.1",
    "typescript": "~5.7.3",
    "vite": "~6.1.0"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ]
}
